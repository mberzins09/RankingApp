<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="RankingApp.Views.ProcessingPopup"
               x:Name="RootPopup">
    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
        <ActivityIndicator IsRunning="True" WidthRequest="50" HeightRequest="50" />
        <Label Text="{Binding Message, Source={x:Reference RootPopup}}" HorizontalOptions="Center" VerticalOptions="Center" />
    </VerticalStackLayout>
</toolkit:Popup>