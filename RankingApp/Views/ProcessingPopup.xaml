<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="RankingApp.Views.ProcessingPopup"
               x:Name="RootPopup">
    <!-- Own dark background, so the light text is readable whatever the popup's default colour is -->
    <Border Style="{StaticResource BoxContainer}" Margin="0" Padding="24,20" MinimumWidthRequest="220">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="True" WidthRequest="44" HeightRequest="44" Color="{StaticResource Accent}"/>
            <Label Text="{Binding Message, Source={x:Reference RootPopup}}" HorizontalOptions="Center" VerticalOptions="Center"
                   HorizontalTextAlignment="Center" Style="{StaticResource PrimaryLabel}" FontSize="14"/>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>