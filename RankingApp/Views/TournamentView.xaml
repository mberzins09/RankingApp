<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:RankingApp.Models"
             xmlns:views="clr-namespace:RankingApp.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:app="using:RankingApp"
             x:DataType="views:TournamentViewModel"
             x:Class="RankingApp.Views.TournamentView"
             Title="Tournament"
             Style="{StaticResource PrimaryContentPage}">
    
    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="50, 50, 30, Auto, *, 5" ColumnDefinitions="5, Auto, *, 50, 50, 50, 5">
        <!-- Row 0 -->
        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Start" Spacing="5">
            <Label Text="{Binding OneTournament.TournamentPlayerName}" Style="{StaticResource PrimaryLabel}"/>
            <Label Text="{Binding OneTournament.TournamentPlayerSurname}" Style="{StaticResource PrimaryLabel}"/>
        </HorizontalStackLayout>
        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource PrimaryLabel}" Text="{Binding OneTournament.PointsDifference}" FontSize="24"/>
        <ImageButton Grid.Row="0" Grid.Column="3" HorizontalOptions="Start" WidthRequest="50" HeightRequest="50" Style="{StaticResource PrimaryImageButton}"
                     Source="gamesnoborder.png" x:Name="BtnAddGame" Clicked="BtnAddGame_OnClicked" />
        <ImageButton Grid.Row="0" Grid.Column="4" HorizontalOptions="Start" WidthRequest="50" HeightRequest="50" Style="{StaticResource PrimaryImageButton}"
             Source="doublesnoborder.png" x:Name="BtnAddDoublesGame" Clicked="BtnAddDoublesGame_OnClicked" />
        <ImageButton Grid.Row="0" Grid.Column="5" WidthRequest="50" HeightRequest="50" Style="{StaticResource PrimaryImageButton}"
                     Source="savenoborder.png" x:Name="BtnSaveTournament" Clicked="BtnSave_OnClicked" />
        <!-- Row 1 -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Entry Grid.Column="1" Style="{StaticResource PrimaryEntry}" Text="{Binding OneTournament.Name}" FontSize="16" VerticalTextAlignment="Center" VerticalOptions="Center"/>
        </Border>
        <!-- Row 2 -->
        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" ColumnDefinitions="100, *, *" ColumnSpacing="10">
            <HorizontalStackLayout >
                <Label Text="Coef:" Grid.Column="0" Style="{StaticResource PrimaryLabel}"/>
                <Border StrokeThickness="2" MaximumWidthRequest="30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="45"/>
                    </Border.StrokeShape>
                    <Picker Style="{StaticResource PrimaryPicker}" ItemsSource="{Binding CoefficientOptions}"
                            SelectedItem="{Binding OneTournament.Coefficient, Mode=TwoWay}" FontSize="14"/>
                </Border>
            </HorizontalStackLayout>
            <Border Grid.Column="1" MaximumWidthRequest="140" HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="45"/>
                </Border.StrokeShape>
                <HorizontalStackLayout>
                    <Label Text="     "/>
                    <app:FormDatePicker MinimumDate="01/01/2000" MaximumDate="01/01/2200" Date="{Binding OneTournament.Date, Mode=TwoWay}"
                                        Format="d MMM yyyy" WidthRequest="120" HeightRequest="40" Style="{StaticResource PrimaryDatePicker}"/>
                    
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="2" StrokeThickness="2" MaximumWidthRequest="90">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="45"/>
                </Border.StrokeShape>
                <Picker Style="{StaticResource PrimaryPicker}" ItemsSource="{Binding GameModes}"
                    SelectedItem="{Binding SelectedGameMode, Mode=TwoWay}"/>
            </Border>
        </Grid>
        <!-- Row 3 -->
        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" RowDefinitions="15, 15, 15, 15" ColumnDefinitions="*, 60, 60, 60, 60" ColumnSpacing="10" RowSpacing="2">
            <!-- Header row -->
            <Label Grid.Row="0" Grid.Column="0" Text="" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="0" Grid.Column="1" Text="Total" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="0" Grid.Column="2" Text="Won" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="0" Grid.Column="3" Text="Lost" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="0" Grid.Column="4" Text="%" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <!-- Games row -->
            <Label Grid.Row="1" Grid.Column="0" Text="Games:" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalGames}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding TotalWins}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="1" Grid.Column="3" Text="{Binding TotalLosses}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="1" Grid.Column="4" Text="{Binding TotalGamesPercentage}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <!-- Sets row -->
            <Label Grid.Row="2" Grid.Column="0" Text="Sets:" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding TotalSets}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="2" Grid.Column="2" Text="{Binding TotalSetsWon}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="2" Grid.Column="3" Text="{Binding TotalSetsLost}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="2" Grid.Column="4" Text="{Binding TotalSetsPercentage}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <!-- Fifth sets row -->
            <Label Grid.Row="3" Grid.Column="0" Text="5th Sets:" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding FifthSetTotal}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding FifthSetsWon}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="3" Grid.Column="3" Text="{Binding FifthSetsLost}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
            <Label Grid.Row="3" Grid.Column="4" Text="{Binding FifthSetWinPercentage}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
        </Grid>
        <!-- Row 4 -->
        <ListView Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" ItemsSource="{Binding DisplayGames}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:IGame">
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Delete" IsDestructive="True"
                              Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                              CommandParameter="{Binding .}" />
                        </ViewCell.ContextActions>
                        <Grid ColumnDefinitions="*, Auto, 20, Auto, 5">
                            <Label Grid.Column="0" Text="{Binding GameDisplayPlayers}" Style="{StaticResource ListItemLabel}" />
                            <Label Grid.Column="1" Text="{Binding Gamescore}" Style="{StaticResource ListItemLabel}" />
                            <Label Grid.Column="2" Text="→" Style="{StaticResource ListItemLabel}" />
                            <Label Grid.Column="3" Text="{Binding RatingDifference}" Style="{StaticResource ListItemLabel}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>