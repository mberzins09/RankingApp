<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:RankingApp.Models"
             xmlns:views="clr-namespace:RankingApp.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:app="using:RankingApp"
             xmlns:selectors="clr-namespace:RankingApp.Converters"
             x:DataType="views:TournamentViewModel"
             x:Class="RankingApp.Views.TournamentView"
             Title="Tournament"
             Style="{StaticResource PrimaryContentPage}">
    <ContentPage.Resources>
        <!-- Define templates -->
        <DataTemplate x:Key="GameTemplate" x:DataType="model:Game">
            <ViewCell>
                <ViewCell.ContextActions>
                    <MenuItem Text="Delete" IsDestructive="True"
                      Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                      CommandParameter="{Binding .}" />
                </ViewCell.ContextActions>
                <Grid ColumnDefinitions="5, *, 5, 50, 20, 50, 10">
                    <Label Grid.Column="1" Text="{Binding OpponentName}" Style="{StaticResource ListItemLabel}"/>
                    <Label Grid.Column="3" Text="{Binding Gamescore}" Style="{StaticResource ListItemLabel}"/>
                    <Label Grid.Column="4" Text="->" Style="{StaticResource ListItemLabel}"/>
                    <Label Grid.Column="5" Text="{Binding RatingDifference}" Style="{StaticResource ListItemLabel}"/>
                </Grid>
            </ViewCell>
        </DataTemplate>

        <DataTemplate x:Key="DoublesGameTemplate" x:DataType="model:DoublesGame">
            <ViewCell>
                <ViewCell.ContextActions>
                    <MenuItem Text="Delete" IsDestructive="True"
                      Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteItemCommand}"
                      CommandParameter="{Binding .}" />
                </ViewCell.ContextActions>
                <Grid ColumnDefinitions="1, *, 3, *, 3, 30, 20, 40, 1">
                    <HorizontalStackLayout Style="{StaticResource PrimaryHorizontal}" Grid.Column="1">
                        <Label Text="{Binding MyPartnerName}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
                        <Label Text="{Binding MyPartnerSurname}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
                    </HorizontalStackLayout>
                    <Label Grid.Column="3" Text="{Binding OpponentTeam}" Style="{StaticResource ListItemLabel}" FontSize="12"/>
                    <Label Grid.Column="5" Text="{Binding Gamescore}" Style="{StaticResource ListItemLabel}" />
                    <Label Grid.Column="6" Text="->" Style="{StaticResource ListItemLabel}"/>
                    <Label Grid.Column="7" Text="{Binding RatingDifference}" Style="{StaticResource ListItemLabel}" />
                </Grid>
            </ViewCell>
        </DataTemplate>

        <!-- Register the selector -->
        <selectors:GameTemplateSelector x:Key="GameTemplateSelector"
                                        GameTemplate="{StaticResource GameTemplate}"
                                        DoublesGameTemplate="{StaticResource DoublesGameTemplate}" />
    </ContentPage.Resources>
    
    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="50, 40, 30, 30, 30, *, 5" ColumnDefinitions="5, 100, *, *, 50, 50, 5">
        <!-- Row 0 -->
        <ImageButton Grid.Row="0" Grid.Column="1" WidthRequest="50" HeightRequest="50" Style="{StaticResource PrimaryImageButton}"
                     Source="savenoborder.png" x:Name="BtnSaveTournament" Clicked="BtnSave_OnClicked" />
        <Label Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource PrimaryLabel}" Text="{Binding OneTournament.PointsDifference}" FontSize="30"/>
        <ImageButton Grid.Row="0" Grid.Column="4" HorizontalOptions="Start" WidthRequest="50" HeightRequest="50" Style="{StaticResource PrimaryImageButton}"
                     Source="gamesnoborder.png" x:Name="BtnAddGame" Clicked="BtnAddGame_OnClicked" />
        <ImageButton Grid.Row="0" Grid.Column="5" HorizontalOptions="Start" WidthRequest="50" HeightRequest="50" Style="{StaticResource PrimaryImageButton}"
             Source="doublesnoborder.png" x:Name="BtnAddDoublesGame" Clicked="BtnAddDoublesGame_OnClicked" />
        <!-- Row 1 -->
        <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource PrimaryEntry}" Text="{Binding OneTournament.Name, Mode=TwoWay}" FontSize="18"/>
        <!-- Row 2 -->
        <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource PrimaryLabel}" HorizontalOptions="Start" Text="Player:"/>
        <HorizontalStackLayout Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4" Style="{StaticResource PrimaryHorizontal}">
            <Label Text="{Binding OneTournament.TournamentPlayerName}" Style="{StaticResource PrimaryLabel}" />
            <Label Text="{Binding OneTournament.TournamentPlayerSurname}" Style="{StaticResource PrimaryLabel}" />
        </HorizontalStackLayout>
        <!-- Row 3 -->
        <Label Grid.Row="3" Grid.Column="1" Style="{StaticResource PrimaryLabel}" HorizontalOptions="Start" Text="Coefficient:"/>
        <Picker Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="4" Style="{StaticResource PrimaryPicker}" Title="Select Coefficient"
                ItemsSource="{Binding CoefficientOptions}" SelectedItem="{Binding OneTournament.Coefficient, Mode=TwoWay}"
                FontSize="16" WidthRequest="100" HeightRequest="40"/>
        <!-- Row 4 -->
        <Label Grid.Row="4" Grid.Column="1" Style="{StaticResource PrimaryLabel}" HorizontalOptions="Start" Text="Date:"/>
        <app:FormDatePicker Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="4" MinimumDate="01/01/2000" MaximumDate="01/01/2200"
                            Date="{Binding OneTournament.Date, Mode=TwoWay}" Format="d MMM yyyy" HorizontalOptions="Center"
                            VerticalOptions="Center" WidthRequest="100" HeightRequest="40"/>
        <!-- Row 5 -->
        <Grid RowDefinitions="40,*" ColumnDefinitions="*, 75, *" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5">
            <!-- Picker -->
            <Picker Grid.Row="0" Grid.Column="1"
                Title="Select Game Mode"
                ItemsSource="{Binding GameModes}"
                SelectedItem="{Binding SelectedGameMode, Mode=TwoWay}" />

            <!-- ListView -->
            <ListView Grid.Row="1" Grid.ColumnSpan="3"
                  ItemsSource="{Binding DisplayGames}"
                  ItemTemplate="{StaticResource GameTemplateSelector}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            </ListView>
        </Grid>
    </Grid>
</ContentPage>