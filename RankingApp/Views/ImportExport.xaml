<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RankingApp.Views.ImportExport"
             Title="ImportExport">
    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="10, 60, *, 60, 10" ColumnDefinitions="10, *, 10">
        <Button Text="Export Database" Clicked="OnExportClicked" Grid.Row="1" Grid.Column="1"
                WidthRequest="300" HeightRequest="60"/>
        <Button Text="Import Database" Clicked="OnImportClicked" Grid.Row="3" Grid.Column="1"
                WidthRequest="300" HeightRequest="60"/>
    </Grid>
</ContentPage>