<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RankingApp.Views"
             xmlns:viewmodel="clr-namespace:RankingApp.Core.ViewModels;assembly=RankingApp.Core"
             xmlns:model="clr-namespace:RankingApp.Core.Models;assembly=RankingApp.Core"
             x:Class="RankingApp.Views.ResultsPage"
             x:DataType="viewmodel:ResultsViewModel"
             Title="Results"
             Style="{StaticResource PrimaryContentPage}">
    <views:BaseContentPage.Resources>
        <!-- Competition: tap to show / hide its events -->
        <DataTemplate x:Key="CompetitionRow" x:DataType="model:CompetitionGroupItem">
            <Grid Padding="6,3">
                <Border Style="{StaticResource Card}" Margin="0">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" Style="{StaticResource ListItemLabel}" FontSize="13"
                                   FontFamily="OpenSansSemibold" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                            <Label Text="{Binding Subtitle}" Style="{StaticResource ListItemSubLabel}" FontSize="12"
                                   HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Chevron}" TextColor="{StaticResource Accent}" FontSize="20"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleCompetitionCommand}"
                                              CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Event of an expanded competition: tap to open it -->
        <DataTemplate x:Key="EventRow" x:DataType="model:CalendarEventItem">
            <Grid Padding="26,2,6,2">
                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{StaticResource GlassStrong}" Padding="12,7">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding EventName}" Style="{StaticResource ListItemLabel}" FontSize="13"
                                   FontFamily="OpenSansSemibold" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                            <Label Text="{Binding Subtitle}" Style="{StaticResource ListItemSubLabel}" FontSize="12"
                                   HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" TextColor="{StaticResource Accent}" FontSize="20" VerticalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenEventCommand}"
                                              CommandParameter="{Binding .}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </DataTemplate>

        <views:ExpandableRowTemplateSelector x:Key="RowSelector"
                                            HeaderTemplate="{StaticResource CompetitionRow}"
                                            ChildTemplate="{StaticResource EventRow}"/>
    </views:BaseContentPage.Resources>

    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="56, Auto, *, 6" ColumnDefinitions="10, *, 10" RowSpacing="4">
        <!-- Row 0: year + month + loading indicator -->
        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="10">
            <Border Style="{StaticResource PickerChip}" WidthRequest="100">
                <Grid ColumnDefinitions="*, Auto">
                    <Picker Title="Year" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Style="{StaticResource ChipPicker}"/>
                    <Label Grid.Column="1" Style="{StaticResource ChipChevron}"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PickerChip}" WidthRequest="150">
                <Grid ColumnDefinitions="*, Auto">
                    <Picker Title="Month" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Style="{StaticResource ChipPicker}"/>
                    <Label Grid.Column="1" Style="{StaticResource ChipChevron}"/>
                </Grid>
            </Border>
            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               HeightRequest="20" WidthRequest="20" VerticalOptions="Center" HorizontalOptions="End"/>
            <Button Grid.Column="3" Text="⟳" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"
                    HeightRequest="40" VerticalOptions="Center"/>
        </Grid>

        <!-- Row 1: status -->
        <Label Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource PrimaryLabel}" FontSize="14"
               HorizontalTextAlignment="Center"/>

        <!-- Row 2: competitions (events inserted below a competition when it is expanded) -->
        <CollectionView Grid.Row="2" Grid.Column="1" Margin="-6,0" ItemsSource="{Binding Rows}" SelectionMode="None"
                        ItemTemplate="{StaticResource RowSelector}"/>
    </Grid>
</views:BaseContentPage>
