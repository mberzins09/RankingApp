<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RankingApp.Views.AllTournaments"
             xmlns:viewmodel="clr-namespace:RankingApp.ViewModels"
             xmlns:model="using:RankingApp.Models"
             x:DataType="viewmodel:AllTournamentsViewModel"
             xmlns:converters="clr-namespace:RankingApp.Converters"
             Title="Rankings"
             Style="{StaticResource PrimaryContentPage}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:YearDisplayConverter x:Key="YearDisplayConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="50, *" ColumnDefinitions="10, 70, *, 70, *, 70, *, 70, 10">
        <ImageButton Grid.Column="1" Source="ranksnoborder.png" Clicked="ImageButtonRankings_Clicked" WidthRequest="60" HeightRequest="50"></ImageButton>
        <ImageButton Grid.Column="3" Source="Gamesnoborder.png" Clicked="ImageButtonAllGames_Clicked" WidthRequest="60" HeightRequest="50"></ImageButton>
        <ImageButton Grid.Column="5" Source="imexpnoborder.png" Clicked="ImportExport_Clicked" WidthRequest="60" HeightRequest="50"></ImageButton>
        <ImageButton Grid.Column="7" Source="{AppThemeBinding Light=addtournamentnoborders.png, Dark=plusnoborder.png}" Clicked="ImageButtonAdd_Clicked" WidthRequest="60" HeightRequest="50"></ImageButton>

        <Grid Style="{StaticResource PrimaryGrid}" Grid.Row="2" Grid.ColumnSpan="9" RowDefinitions="40, 40, *" ColumnDefinitions="100, *">
            <Border StrokeThickness="3" MaximumHeightRequest="35" MaximumWidthRequest="90">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="45"/>
                </Border.StrokeShape>
                <Picker Title="Select Year" ItemsSource="{Binding Years, Mode=TwoWay}" SelectedItem="{Binding SelectedYear}" 
                        Style="{StaticResource PrimaryPicker}">
                    <Picker.ItemDisplayBinding>
                        <Binding Converter="{StaticResource YearDisplayConverter}" />
                    </Picker.ItemDisplayBinding>
                </Picker>
            </Border>
            <SearchBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PrimarySearchBar}" Text="{Binding SearchText, Mode=TwoWay}"/>
            <CollectionView Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Tournaments}" SelectionMode="Single" SelectedItem="{Binding SelectedTournament, Mode=TwoWay}" ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Tournament">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Edit Player" BackgroundColor="LightBlue" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTournamentCommand}" CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Delete" BackgroundColor="Red" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTournamentCommand}" CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="8">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" Style="{StaticResource ListItemLabel}" FontAttributes="Bold"/>
                                    <Label Text="{Binding TournamentDisplay}" Style="{StaticResource ListItemLabel}"/>
                                </VerticalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TournamentSelectedCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>