<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:RankingApp"
             xmlns:rankingApp="using:RankingApp"
             xmlns:model="clr-namespace:RankingApp.Models"
             xmlns:viewmodel="clr-namespace:RankingApp.ViewModels"
             xmlns:views="clr-namespace:RankingApp.Views"
             xmlns:converters="clr-namespace:RankingApp.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:PlayerViewModel"
             x:Class="RankingApp.Views.AllPlayerRanking"
             Title="Players Ranking"
             Style="{StaticResource PrimaryContentPage}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PointsChangedToColorConverter x:Key="PointsChangedToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="5, 40, 40, *, 5" ColumnDefinitions="5, 100, *, *, 80, 40, 5">
        <!-- Row 1 -->
        <Label Text="Downloaded Ranking:" Style="{StaticResource PrimaryLabel}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18"/>
        <Label Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" FontSize="18" Style="{StaticResource PrimaryLabel}" Text="{Binding AppDataLabel}"/>
        <ImageButton Grid.Row="1" Grid.Column="5" Source="dots.png" Clicked="Dots_Clicked"
                     WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="Center"/>
        <!-- Player Filter -->
        <Border Grid.Row="2" Grid.Column="1" StrokeThickness="3" MaximumHeightRequest="30">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="45"/>
            </Border.StrokeShape>
            <Picker FontSize="18" Style="{StaticResource PrimaryPicker}" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" />
        </Border>
        <!-- Date Selection -->
        <Border Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" StrokeThickness="3" MaximumHeightRequest="30">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="45"/>
            </Border.StrokeShape>
            <rankingApp:FormDatePicker Date="{Binding SelectedDate, Mode=TwoWay}"
                                       MinimumDate="{Binding MinDate}" MaximumDate="{Binding MaxDate}" Format="d MMM yyyy"
                                       Style="{StaticResource PrimaryDatePicker}"/>
        </Border>
        <!-- Search + Player List -->
        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" RowDefinitions="40, 15, *" ColumnDefinitions="2, *, 50, 1, 55, 40, 2" Style="{StaticResource PrimaryGrid}">
            <SearchBar Grid.ColumnSpan="5" Style="{StaticResource PrimarySearchBar}" Text="{Binding SearchText, Mode=TwoWay}"/>
            <Label Grid.Row="1" Grid.Column="1" Text="               Player" HorizontalOptions="Start" FontSize="10" VerticalOptions="End"/>
            <Label Grid.Row="1" Grid.Column="2" Text="Points" HorizontalOptions="Center" FontSize="10" VerticalOptions="End"/>
            <Label Grid.Row="1" Grid.Column="4" Text="WithBonus" HorizontalOptions="Center" FontSize="10" VerticalOptions="End"/>
            <Label Grid.Row="1" Grid.Column="5" Text="+/-" HorizontalOptions="Center" FontSize="10" VerticalOptions="End"/>
            <ListView Grid.Row="2" Grid.ColumnSpan="7" Style="{StaticResource PrimaryListView}" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}" SelectionMode="Single" ItemTapped="ListView_ItemTapped">
                <ListView.Behaviors>
                    <toolkit:EventToCommandBehavior
                        EventName="ItemSelected"
                        Command="{Binding PlayerSelectedCommand}"/>
                </ListView.Behaviors>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:PlayerDB">
                        <ViewCell>
                            <Grid Style="{StaticResource PrimaryGrid}" ColumnDefinitions="2, *, 50, 1, 55, 40, 2">
                                <Label Grid.Column="1" Style="{StaticResource ListItemLabel}" LineBreakMode="TailTruncation" MaxLines="1" HorizontalOptions="Start">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedFilter}"
                                                     Value="All">
                                            <Setter Property="Text" Value="{Binding AllDisplay}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedFilter}"
                                                     Value="Men">
                                            <Setter Property="Text" Value="{Binding Display}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedFilter}"
                                                     Value="Women">
                                            <Setter Property="Text" Value="{Binding Display}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectedFilter}"
                                                     Value="Inactive">
                                            <Setter Property="Text" Value="{Binding Display}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.Text>
                                        <Binding Path="AllDisplay" />
                                    </Label.Text>
                                </Label>
                                <Label Grid.Column="2" Style="{StaticResource ListItemLabel}" Text="{Binding Points}"/>
                                <Label Grid.Column="4" Style="{StaticResource ListItemLabel}" Text="{Binding PointsWithBonus}"/>
                                <Label Grid.Column="5" Style="{StaticResource ListItemLabel}" Text="{Binding PointsChanged}"
                                       TextColor="{Binding PointsChanged, Converter={StaticResource PointsChangedToColorConverter}}"/>
                            </Grid>
                            <ViewCell.ContextActions>
                                <MenuItem Text="Set as default player"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetAsDefaultPlayerCommand}"
                                CommandParameter="{Binding .}"/>
                            </ViewCell.ContextActions>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- After Click 3 dots -->
        <Grid x:Name="MoreMenuOverlay" Grid.Row="1" Grid.RowSpan="2"
              Grid.Column="1" Grid.ColumnSpan="4" IsVisible="False" InputTransparent="False">
            <BoxView Style="{StaticResource PrimaryBoxView}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="MoreOverlay_Tapped" NumberOfTapsRequired="1"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="MoreMenuPanel" Style="{StaticResource BoxContainer}"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,8,10,0" WidthRequest="220" IsVisible="True" TranslationX="300">
                <VerticalStackLayout Spacing="6" WidthRequest="200">
                    <Button Text="Refresh Rankings" Clicked="RefreshButton_Clicked" Style="{StaticResource PrimaryButton}"
                            Padding="0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- After Player Clicked -->
        <Grid IsVisible="{Binding IsGamesOverlayVisible}" InputTransparent="False" Grid.RowSpan="5" Grid.ColumnSpan="7">
            <!-- Background -->
            <BoxView Style="{StaticResource PrimaryBoxView}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseGamesOverlayCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <!-- Panel -->
            <Border Style="{StaticResource BoxContainer}" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid RowDefinitions="20, 70, *" ColumnDefinitions="*, 50">
                    <Button Grid.Column="1" FontSize="12" Text="Close" Command="{Binding CloseGamesOverlayCommand}" Style="{StaticResource PrimaryButton}"/>
                    <views:GameStatisticsView BindingContext="{Binding Stats}" Grid.Row="1" Grid.ColumnSpan="2"/>
                    <CollectionView Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding FilteredGames}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Game">
                                <Grid RowDefinitions="*, *" ColumnDefinitions="*, 50">
                                    <Label Text="{Binding GameDisplayPlayers}" FontSize="12" Style="{StaticResource ListItemLabel}"/>
                                    <Label Text="{Binding Gamescore}" FontSize="12" Grid.Column="1" Style="{StaticResource ListItemLabel}"/>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding GameDisplayDetails}" FontSize="12" Style="{StaticResource ListItemLabel}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>