<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:RankingApp.Core.Models;assembly=RankingApp.Core"
    xmlns:converters="clr-namespace:RankingApp.Converters"
    xmlns:local="clr-namespace:RankingApp.Views"
    x:Class="RankingApp.Views.GameListViewPart">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:NumericToColorConverter x:Key="NumericToColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <CollectionView ItemsSource="{Binding ItemsSource, Source={RelativeSource AncestorType={x:Type local:GameListViewPart}}}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="model:IGame">
                <SwipeView BackgroundColor="Transparent">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem
                                Text="{Binding Swipe1Text, Source={RelativeSource AncestorType={x:Type local:GameListViewPart}}}"
                                BackgroundColor="{Binding Swipe1Color, Source={RelativeSource AncestorType={x:Type local:GameListViewPart}}}"
                                Command="{Binding RightPrimaryCommand, Source={RelativeSource AncestorType={x:Type local:GameListViewPart}}}"
                                CommandParameter="{Binding .}" />

                            <SwipeItem
                                Text="{Binding Swipe2Text, Source={RelativeSource AncestorType={x:Type local:GameListViewPart}}}"
                                BackgroundColor="{Binding Swipe2Color, Source={RelativeSource AncestorType={x:Type local:GameListViewPart}}}"
                                Command="{Binding RightSecondaryCommand, Source={RelativeSource AncestorType={x:Type local:GameListViewPart}}}"
                                CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <Border Style="{StaticResource Card}" Padding="12,6">
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, 44, 36" RowSpacing="1">
                            <Label Text="{Binding GameDate}" Style="{StaticResource ListItemSubLabel}" FontSize="11" HorizontalOptions="Start"/>
                            <!-- One Label (not a StackLayout) so it is limited to column 0:
                                 long names wrap instead of running over the score / rating -->
                            <Label Grid.Row="1" HorizontalOptions="Fill" HorizontalTextAlignment="Start"
                                   LineBreakMode="TailTruncation" MaxLines="2">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding GameDisplayMe}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextMain}"/>
                                        <Span Text="  vs  " FontSize="11" TextColor="{StaticResource TextSoft}"/>
                                        <Span Text="{Binding GameDisplayOpp}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextMain}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="2" Text="{Binding TournamentName}" FontSize="11" Style="{StaticResource ListItemSubLabel}"
                                   HorizontalOptions="Start" LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label Grid.Column="1" Grid.RowSpan="3" Text="{Binding Gamescore}" FontSize="13" Style="{StaticResource ListItemLabel}"/>
                            <Label Grid.Column="2" Grid.RowSpan="3" Text="{Binding RatingDifference}" FontSize="14" Style="{StaticResource ListItemLabel}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{Binding RatingDifference, Converter={StaticResource NumericToColorConverter}}"/>
                        </Grid>
                    </Border>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    
</ContentView>