<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:RankingApp.Core.Services;assembly=RankingApp.Core"
             x:Class="RankingApp.Views.GlobalOverlay"
             x:DataType="services:TournamentImportService">
    <Border
        BackgroundColor="#CC000000"
        Padding="12"
        HorizontalOptions="End"
        VerticalOptions="End"
        Margin="16"
        IsVisible="{Binding IsRunning}">

        <VerticalStackLayout WidthRequest="400" HeightRequest="400">

            <Label Text="Importing..."
                   TextColor="White"
                   FontAttributes="Bold"/>

            <Label Text="{Binding Message}"
                   FontSize="12"
                   TextColor="White"/>

            <ProgressBar Progress="{Binding Progress}"
                         HeightRequest="6"/>

        </VerticalStackLayout>

    </Border>
</ContentView>
