<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RankingApp.Views.AllGames"
             xmlns:viewmodel="clr-namespace:RankingApp.ViewModels"
             xmlns:model="using:RankingApp.Models"
             x:DataType="viewmodel:AllGamesViewModel"
             x:Name="ThisPage"
             Title="All Games"
             Style="{StaticResource PrimaryContentPage}">
    
    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="2, 50, *, 2" ColumnDefinitions="100, *">
        <Picker Grid.Row="1" Title="Select Game Mode" ItemsSource="{Binding GameModes}" SelectedItem="{Binding SelectedGameMode, Mode=TwoWay}" 
                Style="{StaticResource PrimaryPicker}" WidthRequest="100"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" RowDefinitions="30, 30, 40, *" ColumnDefinitions="*, *, *, *">
            <HorizontalStackLayout Grid.ColumnSpan="2" Style="{StaticResource PrimaryHorizontal}">
                <Label Text="Games: " Style="{StaticResource ListItemLabel}"/>
                <Label Text="{Binding TotalGames}" Style="{StaticResource ListItemLabel}"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource PrimaryHorizontal}">
                <Label Text="Balance: " Style="{StaticResource ListItemLabel}"/>
                <Label Text="{Binding TotalWins}" Style="{StaticResource ListItemLabel}"/>
                <Label Text=" - " Style="{StaticResource ListItemLabel}"/>
                <Label Text="{Binding TotalLosses}" Style="{StaticResource ListItemLabel}"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PrimaryHorizontal}">
                <Label Text="5 Set games: " Style="{StaticResource ListItemLabel}"/>
                <Label Text="{Binding FifthSetTotal}" Style="{StaticResource ListItemLabel}"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource PrimaryHorizontal}">
                <Label Text="5 Set Win %: " Style="{StaticResource ListItemLabel}"/>
                <Label Text="{Binding FifthSetWinPercentage}" Style="{StaticResource ListItemLabel}"/>
            </HorizontalStackLayout>
            <SearchBar Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PrimarySearchBar}" Text="{Binding SearchText, Mode=TwoWay}" />
            <!--
            <ListView Grid.Row="3" Grid.ColumnSpan="4" ItemsSource="{Binding DisplayGames}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:IGame">
                        <ViewCell>
                            <Grid RowDefinitions="*, *" ColumnDefinitions="*, 50, 2">
                                <Label Grid.ColumnSpan="3" Text="{Binding GameDisplayPlayers}" Style="{StaticResource ListItemLabel}" 
                                       FontSize="{Binding BindingContext.GameFontSize, Source={x:Reference ThisPage}}" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Gamescore}" Style="{StaticResource ListItemLabel}" FontSize="14" FontAttributes="Bold"/>
                                <Label Grid.Row="1" Text="{Binding GameDisplayDetails}" Style="{StaticResource ListItemLabel}" FontSize="14"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            -->
            <CollectionView Grid.Row="3" Grid.ColumnSpan="4" ItemsSource="{Binding DisplayGames}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:IGame">
                        <Grid RowDefinitions="*, *" ColumnDefinitions="*, 50, 2" Padding="5">
                            <Label Grid.ColumnSpan="3" Text="{Binding GameDisplayPlayers}" Style="{StaticResource ListItemLabel}"
                                   FontSize="{Binding BindingContext.GameFontSize, Source={x:Reference ThisPage}}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding Gamescore}" Style="{StaticResource ListItemLabel}"
                                   FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding GameDisplayDetails}" Style="{StaticResource ListItemLabel}" FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>