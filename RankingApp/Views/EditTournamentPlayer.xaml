<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewmodel="clr-namespace:RankingApp.Core.ViewModels;assembly=RankingApp.Core"
             xmlns:model="clr-namespace:RankingApp.Core.Models;assembly=RankingApp.Core"
             xmlns:rankingApp="using:RankingApp"
             x:DataType="viewmodel:EditTournamentPlayerViewModel"
             x:Class="RankingApp.Views.EditTournamentPlayer"
             Title="Tournament Details"
             Style="{StaticResource PrimaryContentPage}">
    <Grid Style="{StaticResource PrimaryGrid}" RowDefinitions="64, 44, *, 6" ColumnDefinitions="10, 100, 100, 100, *, 10">
        <!-- Row 0: save + tournament -->
        <Button Grid.Row="0" Grid.Column="1" Text="💾  Save" WidthRequest="96"
                x:Name="ButtonSave" Clicked="ButtonSave_OnClicked" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start"/>
        <Label Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource PrimaryLabel}" FontFamily="OpenSansSemibold"
               Text="{Binding CurrentTournament.Name}" FontSize="18" LineBreakMode="TailTruncation" MaxLines="2" HorizontalTextAlignment="Center"/>
        <!-- Row 1: current player -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource Card}" Margin="0" Padding="14,0">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                <Label Text="Player" Style="{StaticResource CaptionLabel}"/>
                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <Label Text="{Binding CurrentTournament.TournamentPlayerName}" Style="{StaticResource PrimaryLabel}" FontFamily="OpenSansSemibold"/>
                    <Label Text="{Binding CurrentTournament.TournamentPlayerSurname}" Style="{StaticResource PrimaryLabel}" FontFamily="OpenSansSemibold"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>
        <!-- Row 2: pick another player -->
        <Grid RowDefinitions="56,*" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource PrimaryGrid}">
            <Border Style="{StaticResource GlassField}" VerticalOptions="End">
                <SearchBar Style="{StaticResource PrimarySearchBar}" Placeholder="Search player" Text="{Binding SearchText, Mode=TwoWay}"
                           IsReadOnly="{Binding IsSearchDisabled}"/>
            </Border>
            <ListView Grid.Row="1" x:Name ="AllPlayers" Style="{StaticResource PrimaryListView}"
                      ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:PlayerDB">
                        <ViewCell>
                            <Grid ColumnDefinitions="*, 60" Padding="4,0">
                                <Label Grid.Column="0" Text="{Binding Display}" Style="{StaticResource ListItemLabel}" HorizontalOptions="Start" LineBreakMode="TailTruncation" MaxLines="1"/>
                                <Label Grid.Column="1" Text="{Binding PointsWithBonus}" Style="{StaticResource ListItemLabel}" FontFamily="OpenSansSemibold"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</ContentPage>