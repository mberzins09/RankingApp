<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

		<!--<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>-->

		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>RankingApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Latvia Rankings</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.rankingapp</ApplicationId>
		<!-- <ApplicationId>com.mberzins.rankingapp</ApplicationId> -->

		<!-- Versions -->
		<ApplicationDisplayVersion>4.3</ApplicationDisplayVersion>
		<ApplicationVersion>34</ApplicationVersion>
		<Version>$(ApplicationDisplayVersion)</Version>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!--
		Android Release: shrink the Java (DEX) code with R8 - Google Play "DEX code optimization".
		DEX goes from ~15.6 MB to ~8.6 MB, under Play's 10 MB size where the optimization scores are enforced.
		Class names are not obfuscated (.NET for Android always adds -dontobfuscate). Do not add obfuscation rules.
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidLinkTool>r8</AndroidLinkTool>
	</PropertyGroup>

	<!--
		Workaround for an SDK bug (36.1.69) that crashed version 32 (4.1) on start:
		  ClassNotFoundException androidx.appcompat.widget.FitWindowsFrameLayout
		aapt2 writes obj/.../aapt_rules.txt - R8 keep rules for classes used only from layout XML / the manifest.
		The SDK passes it to R8 only when the resources are re-linked. On the next build the resources are up to
		date, the file is not listed as a build output any more, IncrementalClean deletes it, and the following
		R8 run removes those classes. So: re-link when the file is missing, always pass it to R8, keep it from being
		deleted, and stop the build if R8 would still run without it.
	-->
	<Target Name="_RankingAppRelinkWhenAaptRulesMissing" BeforeTargets="_CreateBaseApk"
	        Condition="'$(AndroidLinkTool)' == 'r8' And !Exists('$(IntermediateOutputPath)aapt_rules.txt')">
		<Delete Files="$(_PackagedResources)" />
	</Target>

	<Target Name="_RankingAppUseAaptRules" AfterTargets="_CalculateProguardConfigurationFiles"
	        Condition="'$(AndroidLinkTool)' == 'r8'">
		<Error Condition="!Exists('$(IntermediateOutputPath)aapt_rules.txt')"
		       Text="aapt_rules.txt is missing - R8 would remove classes used by layouts and the app would crash on start. Delete the bin and obj folders and build again." />
		<ItemGroup>
			<_ProguardConfiguration Remove="$(IntermediateOutputPath)aapt_rules.txt" />
			<_ProguardConfiguration Include="$(IntermediateOutputPath)aapt_rules.txt" />
			<FileWrites Include="$(IntermediateOutputPath)aapt_rules.txt" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		          <!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Oscore.Maui.Android.InAppUpdates" Version="1.2.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\RankingApp.Core\RankingApp.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\EditTournamentPlayer.xaml.cs">
	    <DependentUpon>EditTournamentPlayer.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\Games.xaml.cs">
	    <DependentUpon>Games.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\AllPlayerRanking.xaml.cs">
	    <DependentUpon>AllPlayerRanking.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\.xaml.cs">
	    <DependentUpon>.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\TournamentView.xaml.cs">
	    <DependentUpon>TournamentView.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Views\DoublesGameView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\EditTournamentPlayer.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\GameListViewPart.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\Games.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\AllPlayerRanking.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\GameStatisticsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ImportTournament.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ProcessingPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\TournamentView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\AllGames.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\AllTournaments.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>
</Project>
