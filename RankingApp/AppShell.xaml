<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RankingApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RankingApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="RankingApp">

        <!-- Start page. The tournament list (AllTournaments) is a pushed route registered in AppShell.xaml.cs -->
        <ShellContent
            Title="RankingApp"
            Route="HomePage"
            ContentTemplate="{DataTemplate views:HomePage}" />

</Shell>

