<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RankingApp"
             x:Class="RankingApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Label -->
            <Style TargetType="Label" x:Key="PrimaryLabel">
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Label in ListItem-->
            <Style TargetType="Label" x:Key="ListItemLabel">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <!-- SearchBar -->
            <Style TargetType="SearchBar" x:Key="PrimarySearchBar">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="Placeholder" Value="Search..." />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- ListView -->
            <Style TargetType="ListView" x:Key="PrimaryListView">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
                <Setter Property="SeparatorColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
            </Style>

            <!-- Grid -->
            <Style TargetType="Grid" x:Key="PrimaryGrid">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
            </Style>

            <!-- DatePicker -->
            <Style TargetType="local:FormDatePicker" x:Key="PrimaryDatePicker">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <!-- Picker -->
            <Style TargetType="Picker" x:Key="PrimaryPicker">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Picker" x:Key="BoxedPicker" BasedOn="{StaticResource PrimaryPicker}">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                <Setter Property="VerticalOptions" Value="End"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <!-- Border -->
            <Style TargetType="Border" x:Key="BoxContainer">
                <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="4,4,4,8"/>
                <Setter Property="Stroke" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
            </Style>

            <!-- Entry -->
            <Style TargetType="Entry" x:Key="PrimaryEntry">
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- ImageButton -->
            <Style TargetType="ImageButton" x:Key="PrimaryImageButton">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <!-- BoxView -->
            <Style TargetType="BoxView" x:Key="PrimaryBoxView">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
            </Style>
                <!-- Button -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="BorderColor" Value="{AppThemeBinding Dark={StaticResource Gray500}, Light={StaticResource Gray200}}"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <!-- ContentPage -->
            <Style TargetType="ContentPage" x:Key="PrimaryContentPage">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
            </Style>

            <!-- HorizontalStackLayout -->
            <Style TargetType="HorizontalStackLayout" x:Key="PrimaryHorizontal">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Spacing" Value="3" />
            </Style>

            <!-- VerticalStackLayout -->
            <Style TargetType="VerticalStackLayout" x:Key="PrimaryVertical">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray300}}"/>
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Spacing" Value="3" />
                <Setter Property="Padding" Value="3" />
            </Style>

            <!-- ActivityIndicator -->
            <Style TargetType="ActivityIndicator" x:Key="PrimaryActivity">
                <Setter Property="Color" Value="{AppThemeBinding Dark={StaticResource Gray300}, Light={StaticResource Gray600}}"/>
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="WidthRequest" Value="30" />
                <Setter Property="HeightRequest" Value="30" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
